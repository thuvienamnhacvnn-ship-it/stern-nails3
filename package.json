{
  "name": "stern-nails",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3110",
    "build": "tsx --tsconfig tsconfig.scripts.json scripts/build-db.ts && next build",
    "start": "next start -p 3110",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/build-assets.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig tsconfig.scripts.json scripts/db-migrate.ts",
    "db:seed": "tsx --tsconfig tsconfig.scripts.json scripts/seed.ts",
    "db:reset": "node -e \"require('node:fs').rmSync('.data/pg',{recursive:true,force:true})\" && npm run db:migrate && npm run db:seed",
    "test": "tsx --tsconfig tsconfig.scripts.json scripts/test/run.ts",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "drizzle-orm": "0.45.2",
    "@electric-sql/pglite": "0.5.8",
    "zod": "4.5.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  }
}
