# Stern Nails 3 — environment
#
# Copy to .env.local and fill in what you actually have. Everything below has a
# safe default, and every default is the inert one: no mail leaves the machine,
# no money moves, no model is called. Nothing in this file is a secret; the real
# .env.local is gitignored and must never be committed.

# ---------------------------------------------------------------- demo mode
#
# On (the default) the interface carries a DEMO badge, card and PayPal run on
# the built-in fake provider, and mail is written to .data/outbox/ instead of
# being sent. Turn it off only once the studio's details, prices and payment
# account are in place.
DEMO_MODE=1

# Where the site is reachable. Used for the links inside confirmation mail, so
# it has to be the address a customer's phone can actually open.
PUBLIC_URL=http://localhost:3110

# ----------------------------------------------------------------- database
#
# A directory, not a connection string: the local build runs PGlite, which is
# Postgres compiled to WebAssembly and stored on disk. Moving to a Postgres
# server later replaces this with a DATABASE_URL and the schema is unchanged.
#
# One process at a time. Stop `npm run dev` before running a migration or seed.
DATABASE_DIR=.data/pg

# --------------------------------------------------------------------- mail
#
# `outbox` writes every message to the notification_job table and to
# .data/outbox/, where the admin outbox page shows it. Any other value needs an
# adapter implementing in src/lib/notify.ts — an unimplemented provider fails
# the job loudly rather than pretending to have sent it.
EMAIL_PROVIDER=outbox
EMAIL_FROM=no-reply@stern-nails.example

# ----------------------------------------------------------------- payments
#
# `demo` is the built-in fake: it creates intents, signs its own webhooks and
# moves nothing. `stripe` and `paypal` are recognised names with no
# implementation behind them yet; selecting one makes checkout fail rather than
# silently succeed.
#
# The webhook secret signs and verifies the event body. Replace it with the
# provider's own signing secret when one exists.
PAYMENT_PROVIDER=demo
PAYMENT_WEBHOOK_SECRET=demo-webhook-secret

# --------------------------------------------------------------- AI stylist
#
# `rules` is the offline recommender that runs over the published lookbook. It
# needs no key, no network and no budget, and it is what the demo uses.
#
# Set AI_PROVIDER=gemini and supply a key to use a model instead. The model only
# ever reorders and explains looks that already exist; ids it invents are
# discarded. No customer detail is ever put in a prompt.
AI_PROVIDER=rules
AI_API_KEY=
AI_MODEL=gemini-2.5-flash-latest
AI_TIMEOUT_MS=8000

# --------------------------------------------------------------- WhatsApp
#
# Off until the studio has its own number, a business account, and the
# customer's explicit choice to be contacted that way. Nothing is queued while
# this is 0.
WHATSAPP_ENABLED=0
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# -------------------------------------------------------------------- admin
#
# The password the seed gives the three demo staff accounts. Change it before
# anything is reachable from outside this machine.
ADMIN_SEED_PASSWORD=stern-demo-2026
